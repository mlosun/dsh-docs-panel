{
  "name": "dsh-docs-panel",
  "version": "0.0.1",
  "description": "DSH WebUI 里的「随身手册」：全局 Markdown 笔记，任何工作区随时可读。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "author": "mlosun",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "docs",
    "reading",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlosun/dsh-docs-panel.git"
  },
  "homepage": "https://github.com/mlosun/dsh-docs-panel#readme"
}
